<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Archive - Bright Side</title>
<meta name="description" content="Browse every past Bright Side word search puzzle.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<script data-goatcounter="https://ellac730.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
<style>
  :root{
    --bg: #EDF1F2;
    --surface: #FFFFFF;
    --ink: #2B3A42;
    --muted: #7C8B93;
    --accent: #F2B705;
    --accent-soft: #FCE9AE;
    --line: #DCE3E5;
    --radius: 18px;
  }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--bg); color:var(--ink); font-family:'Inter', sans-serif; -webkit-font-smoothing:antialiased; }
  .wrap{ max-width:680px; margin:0 auto; padding:32px 20px 80px; }
  header.top{ display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; padding-bottom:20px; margin-bottom:32px; border-bottom:1px solid var(--line); }
  .brand{ font-family:'Fraunces', serif; font-weight:700; font-size:22px; letter-spacing:-0.01em; }
  .brand a{ text-decoration:none; color:var(--ink); }
  .brand span{ color: var(--accent); }
  nav.main-nav{ display:flex; gap:26px; flex-wrap:wrap; }
  .nav-link{ font-family:'Inter', sans-serif; font-size:15px; font-weight:500; color:var(--muted); text-decoration:none; padding-bottom:4px; border-bottom:2px solid transparent; }
  .nav-link:hover{ color:var(--ink); }
  .nav-link.active{ color:var(--ink); font-weight:600; border-bottom:2px solid var(--accent); }
  h1.page-title{ font-family:'Fraunces', serif; font-weight:600; font-size:32px; margin:0 0 28px; letter-spacing:-0.01em; }
  .archive-list{ display:flex; flex-direction:column; gap:12px; }
  .archive-item{ display:flex; align-items:center; justify-content:space-between; gap:12px; background:var(--surface); border-radius:var(--radius); padding:16px 20px; text-decoration:none; color:var(--ink); box-shadow:0 1px 2px rgba(43,58,66,0.04); }
  .archive-item:hover{ box-shadow:0 4px 14px rgba(43,58,66,0.08); }
  .archive-item .left{ display:flex; align-items:center; gap:12px; }
  .archive-item .emoji{ font-size:22px; }
  .archive-item .theme{ font-family:'Fraunces', serif; font-weight:600; font-size:17px; }
  .archive-item .day{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--muted); }
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <div class="brand"><a href="index.html">Bright <span>Side</span></a></div>
    <nav class="main-nav">
      <a href="index.html" class="nav-link">Today's Puzzle</a>
      <a href="archive.html" class="nav-link active">Archive</a>
      <a href="create.html" class="nav-link">Create</a>
      <a href="reviews.html" class="nav-link">Reviews</a>
      <a href="about.html" class="nav-link">About</a>
      <a href="https://www.youtube.com/watch?v=M1jUGyJ6i9Q" class="nav-link" target="_blank" rel="noopener noreferrer">Webinar</a>
    </nav>
  </header>

  <h1 class="page-title">Past Puzzles</h1>

  <div class="archive-list" id="archiveList"></div>

</div>

<script src="puzzles.js"></script>
<script>
  const LAUNCH_DATE = new Date('2026-08-28'); // must match the value in index.html
  function getTodayIndex(){
    const today = new Date(); today.setHours(0,0,0,0);
    const start = new Date(LAUNCH_DATE); start.setHours(0,0,0,0);
    const diff = Math.floor((today - start) / 86400000);
    return Math.max(0, Math.min(diff, PUZZLES.length - 1));
  }
  const todayIdx = getTodayIndex();
  const listEl = document.getElementById('archiveList');
  for(let i = todayIdx; i >= 0; i--){
    const p = PUZZLES[i];
    const a = document.createElement('a');
    a.className = 'archive-item';
    a.href = 'index.html?day=' + i;
    a.innerHTML =
      '<div class="left"><span class="emoji">' + (p.emoji || '') + '</span>' +
      '<span class="theme">' + p.theme + '</span></div>' +
      '<span class="day">Day ' + (i + 1) + '</span>';
    listEl.appendChild(a);
  }
</script>
</body>
</html>
